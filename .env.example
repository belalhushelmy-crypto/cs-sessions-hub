# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Google Gemini (server only). Leave the key empty to grade manually.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Development only: deterministic fake grader when the key above is empty.
GEMINI_MOCK=0

# Seed script only (npm run seed) — demo data, never in production
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_STUDENT_PASSWORD=Student123!

# First production admin (npm run create-admin) — no demo data
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=CS Teacher

# Cloudflare Turnstile (CAPTCHA) - optional in dev, required in production
# Get keys from https://dash.cloudflare.com/ -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Absolute URL for OTP/resend redirects (used by signup and resend-otp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
